<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NetOidc Client</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" crossorigin="anonymous" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">NetOidc Client</a>
            <div class="navbar-nav ms-auto d-flex flex-row align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" asp-page="/Profile">Profile</a>
                    <form method="post" asp-page="/Logout">
                        <button type="submit" class="btn btn-sm btn-outline-light">
                            Sign out (@User.Identity.Name)
                        </button>
                    </form>
                }
                else
                {
                    <a class="nav-link" asp-page="/Profile">Sign in</a>
                }
            </div>
        </div>
    </nav>
    <main class="container">
        @RenderBody()
    </main>
</body>
</html>
