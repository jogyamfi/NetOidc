<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(IsTestProject)' != 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- NuGet package metadata shared across all packable projects -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <Version>0.9.0</Version>
    <Authors>NetOidc Contributors</Authors>
    <Company>NetOidc</Company>
    <Copyright>Copyright © 2024 NetOidc Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/example/net-oidc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/example/net-oidc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>oauth2;oidc;openid-connect;authentication;aspnetcore</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
</Project>
