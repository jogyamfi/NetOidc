<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetOidc.Provider.Abstractions\NetOidc.Provider.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.22.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>NetOidc.Provider</PackageId>
    <Title>NetOidc Provider</Title>
    <Description>A configurable OAuth 2.0 / OpenID Connect Provider library for ASP.NET Core 8. Mounts into any ASP.NET Core app via MapNetOidc(). Supports PKCE, PAR, JAR, JARM, DPoP, mTLS, DCR, CIBA, Device Flow, FAPI 1/2, Federation, and OID4VCI.</Description>
  </PropertyGroup>

</Project>
